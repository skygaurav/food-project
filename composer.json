{
    "name": "skygaurav/food-project",
    "description": "Food project",
    "type": "project",
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
        ,
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "scripts": {},
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}

{
    "name": "skygaurav/food-project",
    "description": "Food project",
    "type": "project",
    "require": {
        "php": "^8.2",
        "anhskohbo/no-captcha": "^3.7",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
        ,
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php artisan storage:link --quiet --force"
        ],
        "post-update-cmd": [
            "@php artisan storage:link --quiet --force"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
